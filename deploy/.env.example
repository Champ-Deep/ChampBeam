# Champbeam backend, VPS (Docker Compose) environment.
# Copy this to a file named .env in this deploy/ directory, fill in the blanks,
# then: docker compose up -d --build

# --- App ---
APP_NAME=Champbeam
ENVIRONMENT=production
DEBUG=false

# --- Postgres (the compose 'postgres' service) ---
# These initialize the database container AND must match DATABASE_URL below.
POSTGRES_USER=champbeam
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=champbeam
DATABASE_URL=postgresql://champbeam:change-me-to-a-strong-password@postgres:5432/champbeam

# --- Redis (the compose 'redis' service) ---
REDIS_URL=redis://redis:6379/0

# --- Auth (Clerk production keys) ---
CLERK_SECRET_KEY=sk_live_...
# Turns on issuer verification (recommended for prod). The Frontend API host is
# encoded in the publishable key, so this is all that's needed to enforce `iss`.
CLERK_PUBLISHABLE_KEY=pk_live_...
# Restrict which origins' tokens are accepted (the `azp` claim). Defaults to
# FRONTEND_URL when blank.
# CLERK_AUTHORIZED_PARTIES=https://app.champbeam.com
# Svix secret for the Clerk webhook (Dashboard -> Webhooks -> add
# https://champbeam.com/api/v1/webhooks/clerk, subscribe user.* + organization*).
# Keeps the local user/org/membership mirror authoritative.
CLERK_WEBHOOK_SECRET=whsec_...

# --- Public host: champbeam.com root serves API + short links + files ---
REDIRECT_BASE_URL=https://champbeam.com
PLATFORM_REDIRECT_HOST=champbeam.com

# --- CORS: where the app UI (on Vercel) is served ---
FRONTEND_URL=https://app.champbeam.com

# --- File storage: Cloudflare R2 (durable, decoupled from the droplet disk) ---
STORAGE_BACKEND=s3
SUPABASE_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
SUPABASE_STORAGE_REGION=auto
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=champbeam-files
STORAGE_UPLOAD_SECRET=change-me-to-a-long-random-string

# --- Error monitoring (Sentry, wired by your intern) ---
# Self-hosted Sentry on this droplet. Leave blank until the SDK is added; set
# the project DSN here to turn it on. See the README "Error monitoring" notes.
SENTRY_DSN=

# --- Custom domains: bring-your-own (Cloudflare for SaaS Custom Hostnames) ---
# A customer points track.acme.com at us and we issue/serve the cert. All three
# enable the BYOD path. Leave blank to keep BYOD off (added domains stay pending
# until reachable). See README "Custom Domains".
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CNAME_TARGET=cname.champbeam.com

# --- Domain procurement: buy a domain in-app (Cloudflare Registrar API, beta) ---
# Account-scoped. The token above must have Registrar write scope. When set,
# Settings -> Domains shows a "Get a new domain" search/buy flow.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_REGISTRANT_EMAIL=domains@champbeam.com

# --- GeoIP + ISP/VPN detection ---
# Strongly recommended in production: local MaxMind GeoLite2 databases give
# instant, unlimited geo + ISP/VPN (ASN) lookups with NO external calls. The
# ip-api.com fallback is rate-limited and its free tier blocks datacenter/VPS
# IPs, so VPN/ISP detection silently fails on a droplet without these DBs.
#
# Set a free MaxMind license key (https://www.maxmind.com/en/geolite2/signup)
# and the app downloads both City + ASN databases on boot into the persisted
# geoipdata volume (one-time):
# MAXMIND_LICENSE_KEY=
#
# Without a key, detection falls back to ip-api.com:
# GEOIP_PROVIDER=ipapi
