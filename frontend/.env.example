# Champbeam frontend (Vite) environment variables.
#
# These are BUILD-TIME variables: Vite inlines anything prefixed with VITE_ into
# the bundle when you build/deploy. Set them in your hosting provider (Vercel ->
# Project -> Settings -> Environment Variables), NOT on the Railway backend.
# After changing them you must REDEPLOY the frontend for the new value to take
# effect.

# Clerk publishable key for the browser. THIS is the key that controls whether
# the app runs against your Clerk development or production instance:
#   pk_test_...  -> development instance  (shows "Development mode" on sign-in)
#   pk_live_...  -> production instance
# To go live, set this to your pk_live_... key and redeploy.
# NOTE: the prefix is VITE_ (this is a Vite/React app). Clerk's dashboard
# "Quick copy" may show NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY for Next.js — ignore
# the variable name it suggests and just use the key VALUE here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the backend API (the Railway/VPS host). The client appends
# /api/v1 automatically if you omit it.
VITE_API_URL=https://your-backend-host
