# ChampBeam frontend (Vite).
#
# Production builds usually leave these unset. The Cloudflare Worker serves the
# SPA and /api/v1 on the same origin (https://champbeam.com), and the client
# defaults to /api/v1 when VITE_API_URL is empty.
#
# Local hot reload: copy this file to frontend/.env.local. Vite proxies /api
# to wrangler on 127.0.0.1:8799 (frontend/vite.config.ts). Also set
# BETTER_AUTH_URL=http://localhost:5173 in worker/.dev.vars.
#
# Vite inlines VITE_* at build time. Workers Builds (root directory worker)
# is where production build variables belong. Changing one requires a rebuild.
# Placeholders only. Do not put real client ids, tokens, or secrets in git.

# Same-origin API. Required for `npm run dev` so requests stay on the Vite
# origin and the session cookie works. Leave unset for the production Worker
# build. If you omit it during `npm run dev`, the client calls
# http://localhost:8000/api/v1 (the legacy FastAPI port), not the Worker.
VITE_API_URL=/api/v1

# Public Google OAuth client id. The sign-in page shows "Continue with Google"
# only when this is set. It must be the same id as the Worker's GOOGLE_CLIENT_ID.
# Not a secret (it is sent in the Google sign-in URL). Still use a placeholder
# here, not a live id.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional dismissible banner. Unset means no banner.
# VITE_ANNOUNCEMENT=Short notice shown at the top of the app
