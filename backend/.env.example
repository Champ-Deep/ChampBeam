# Application
APP_NAME=ChampUTM
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# PostgreSQL Database
# For local development, use these defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=champutm
POSTGRES_PASSWORD=champutm_dev
POSTGRES_DB=champutm

# On Railway, the Postgres plugin auto-injects DATABASE_URL, leave the
# POSTGRES_* values above unset (or matching the plugin) in production.
# DATABASE_URL=postgresql://user:password@host:port/database

# Clerk session-token verification. Required for any auth-gated endpoint
# (presets, link generation, files, domains, analytics). Mint a key in
# your Clerk dashboard; sk_test_... for local, sk_live_... for prod.
CLERK_SECRET_KEY=

# Redis Cache. On Railway, the Redis plugin auto-injects REDIS_URL.
REDIS_URL=redis://localhost:6379/0

# Frontend origin used for CORS. Must exactly match where the SPA is
# served (Vite dev server locally; your Vercel host in prod).
FRONTEND_URL=http://localhost:5173

# Optional override for short-link base URL. When unset (the default),
# /api/v1/utm/generate uses request.base_url so URLs match whatever host
# the client called. Set this only if you sit behind a reverse proxy that
# rewrites Host, or you explicitly want all short links to use a fixed
# hostname. Short links resolve on the BACKEND (Railway), not the SPA.
# REDIRECT_BASE_URL=https://<your-railway-host>

# Hostname (no scheme) the redirect handler treats as the platform default
# when routing /r/* and /f/* by Host header. Derived from REDIRECT_BASE_URL
# if unset. Override only when your platform host differs (e.g. running
# behind a CDN that rewrites Host) or for the test suite.
# PLATFORM_REDIRECT_HOST=<your-railway-host>.up.railway.app

# Platform subdomains (Netlify-style instant tenant domains). Set this to the
# base zone you own a wildcard for, e.g. "share.lakeb2b.com". A tenant can then
# claim a single-label subdomain like acme.share.lakeb2b.com in Settings, and it
# goes live instantly (no per-host cert) because the platform wildcard covers it.
#
# IMPORTANT sequencing: only set this AFTER the wildcard is actually live:
#   1. DNS: CNAME  *.share.lakeb2b.com  ->  <your-railway-host>.up.railway.app
#      (or a Cloudflare-proxied CNAME, which also issues the wildcard cert)
#   2. TLS: a wildcard cert for *.share.lakeb2b.com must be serving
# Claimed subdomains are marked active immediately, so enabling this before the
# wildcard resolves would show a domain as "Live" that does not actually connect.
# Leave empty to hide the "Claim a subdomain" option entirely.
# PLATFORM_SUBDOMAIN_BASE=share.lakeb2b.com

# Cloudflare for SaaS, Custom Hostnames (BYOD: a customer points track.acme.com
# at us and we issue/serve the cert for it). All three enable the BYOD path:
#   CLOUDFLARE_API_TOKEN   token scoped to "SSL and Certificates: Edit" on the zone
#   CLOUDFLARE_ZONE_ID     the zone that has Cloudflare for SaaS enabled
#   CLOUDFLARE_CNAME_TARGET the hostname customers CNAME to (your fallback origin)
# When unset (the default), the "Add your own domain" option is shown as not yet
# enabled, and any external domain added stays PENDING (never shown as Live)
# until it is reachable. Platform subdomains above need NONE of this. No backend
# code changes are required to turn BYOD on, set these three and redeploy.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CNAME_TARGET=cname.champutm.com

# Supabase Storage, standalone blob store for the file-hosting feature.
# Used via its S3-compat endpoint; we DO NOT use Supabase as the DB. Leave
# blank for local development without file hosting; the /api/v1/files
# endpoints will return 503 with a setup hint.
# To set this up: create a Supabase project, create a bucket named "files"
# (or your preferred name), enable Storage's S3 protocol, and mint an
# access key + secret in the project settings.
# SUPABASE_STORAGE_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_REGION=us-east-1
# SUPABASE_STORAGE_ACCESS_KEY_ID=
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_BUCKET=files
# Per-user storage cap in bytes (default 5 GiB). v1 ships hardcoded; later
# tiering will move this to a per-user column.
# MAX_BYTES_PER_USER=5368709120

# Storage backend selection.
#   "local" (default) writes uploads to a local disk path and routes upload +
#           serve through the API, no external bucket required. On Railway,
#           point STORAGE_LOCAL_PATH at a MOUNTED VOLUME or uploads are wiped on
#           every redeploy. This is the fastest way to get file sharing working.
#   "s3"    uses the SUPABASE_STORAGE_* (or any S3-compatible) bucket above with
#           the presigned-URL flow. Flip to this to scale up, no code changes.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/files
# HMAC secret for the short-lived local blob-upload tokens. Set a long random
# value in production; falls back to CLERK_SECRET_KEY when empty.
STORAGE_UPLOAD_SECRET=
# Anonymous (signed-out) uploads auto-expire after this many seconds (default
# 24h); a background sweeper reclaims them on this interval.
ANON_FILE_TTL_SECONDS=86400
ANON_SWEEP_INTERVAL_SECONDS=900

# --- MongoDB GridFS backend (STORAGE_BACKEND=mongo) ---
# Store file bytes in GridFS. Great for Railway: add the Mongo plugin, set
# STORAGE_BACKEND=mongo and MONGO_URL below. No volume needed; survives
# redeploys. The app's primary DB stays PostgreSQL, Mongo holds blobs only.
# MONGO_URL=mongodb://user:pass@host:port    # Railway Mongo plugin injects this
# MONGO_DB=champutm_files
# MONGO_BUCKET=fs

# --- Cloudflare R2 / any S3-compatible scale-up (STORAGE_BACKEND=s3) ---
# R2 is S3-compatible, so the SUPABASE_STORAGE_* vars above point at it with no
# code change. Create a bucket + an R2 API token (S3 credentials) in the
# Cloudflare dashboard, then:
# STORAGE_BACKEND=s3
# SUPABASE_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# SUPABASE_STORAGE_REGION=auto
# SUPABASE_STORAGE_ACCESS_KEY_ID=<R2 access key id>
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=<R2 secret access key>
# SUPABASE_STORAGE_BUCKET=<your bucket>
