# Application
APP_NAME=ChampUTM
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# PostgreSQL Database
# For local development, use these defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=champutm
POSTGRES_PASSWORD=champutm_dev
POSTGRES_DB=champutm

# For Railway or other cloud platforms, set DATABASE_URL to override individual settings
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Authentication
# IMPORTANT: Change this in production! Must be at least 32 characters.
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# Base URL used when generating short links (e.g., https://champ-utm.vercel.app).
# Defaults to http://localhost:8000 if unset. Set in production.
# REDIRECT_BASE_URL=https://champ-utm.vercel.app

# Hostname (no scheme) treated as the platform default when routing /r/* by
# Host header. Derived from REDIRECT_BASE_URL if unset. Override only if your
# platform default differs from REDIRECT_BASE_URL's host.
# PLATFORM_REDIRECT_HOST=champ-utm.vercel.app

# Cloudflare for SaaS — Custom Hostnames (BYOD).
# Leave both blank for local development; the /api/v1/domains endpoints will
# create domains in "active" status without provisioning a CF cert, so the
# happy path is testable end-to-end via curl with a spoofed Host header.
# In production, set both values from your Cloudflare zone.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CNAME_TARGET=cname.champutm.com

# Supabase Storage — standalone blob store for the file-hosting feature.
# Used via its S3-compat endpoint; we DO NOT use Supabase as the DB. Leave
# blank for local development without file hosting; the /api/v1/files
# endpoints will return 503 with a setup hint.
# To set this up: create a Supabase project, create a bucket named "files"
# (or your preferred name), enable Storage's S3 protocol, and mint an
# access key + secret in the project settings.
# SUPABASE_STORAGE_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_REGION=us-east-1
# SUPABASE_STORAGE_ACCESS_KEY_ID=
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_BUCKET=files
# Per-user storage cap in bytes (default 5 GiB). v1 ships hardcoded; later
# tiering will move this to a per-user column.
# MAX_BYTES_PER_USER=5368709120
