{
  "name": "champbeam-worker",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply champbeam --local",
    "db:migrate:remote": "wrangler d1 migrations apply champbeam --remote",
    "build:frontend:intranet": "node scripts/build-intranet-frontend.mjs",
    "deploy:intranet": "node scripts/check-env-overlays.mjs --deployable && node scripts/build-intranet-frontend.mjs && wrangler deploy --env intranet",
    "db:migrate:intranet": "wrangler d1 migrations apply DB --env intranet --remote",
    "db:migrate:intranet:local": "wrangler d1 migrations apply DB --env intranet --local",
    "dev:intranet": "wrangler dev --env intranet --port 8798 --test-scheduled",
    "intranet:bootstrap": "node scripts/intranet-bootstrap.mjs",
    "intranet:acceptance": "node scripts/intranet-acceptance.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.intranet.config.ts",
    "test:intranet": "vitest run -c vitest.intranet.config.ts",
    "cf-typegen": "wrangler types"
  },
  "type": "module",
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.152.0"
  },
  "private": true
}
