// ChampBeam on Cloudflare: ONE Worker serves everything.
//
//   /api/*, /r/*, /s/*, /f/*, /p/*, /rooms/*, /health  -> the API (Hono, src/)
//   everything else                                    -> the React SPA (static
//                                                         assets built from
//                                                         ../frontend/dist)
//
// Bindings:
//   DB     D1 (SQLite) — replaces Postgres. Schema lives in ./migrations.
//   FILES  R2 bucket   — replaces Mongo GridFS / local disk / S3 for file bytes.
//   ASSETS static assets (the built frontend).
// Cron replaces the in-process background loops of the Python app.
//
// First-time setup (see ../CLOUDFLARE_DEPLOY.md):
//   npx wrangler d1 create champbeam            -> paste database_id below
//   npx wrangler r2 bucket create champbeam-files
//   npx wrangler d1 migrations apply champbeam --remote   (0007 adds the Better Auth tables)
//   npx wrangler secret put BETTER_AUTH_SECRET  (32+ random bytes; the Worker refuses requests without it)
//   npx wrangler secret put STORAGE_UPLOAD_SECRET (required: upload signing and access codes)
//   npx wrangler secret put GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (Google sign-in; off when unset)
//   (and the other secrets below)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "champbeam",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Password reset mail (champbeam.com is onboarded in Cloudflare Email Service). Overlays do not inherit it: staging declares its own.
  "send_email": [{ "name": "EMAIL" }],

  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs first for everything except hashed build assets. Root-slug
    // hosting (https://<share-host>/<slug>) cannot be listed as a path: the SPA
    // fallback would answer it first. Non-matching GET/HEAD requests fall through
    // to ASSETS in src/app.ts, so SPA routes still work.
    "run_worker_first": ["/*", "!/assets/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "champbeam",
      "database_id": "f4adff8c-771e-4e18-b792-dc9f8f3dbd99",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "champbeam-files"
    }
  ],

  "triggers": {
    // */15: expired-upload sweeper + rate-counter cleanup.
    // */5 : custom-domain status refresh (Cloudflare for SaaS / DNS checks).
    "crons": ["*/15 * * * *", "*/5 * * * *"]
  },

  "observability": { "enabled": true },

  // Non-secret configuration. BETTER_AUTH_URL is the app origin Better Auth serves /api/auth from (the
  // Google redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google). Secrets (BETTER_AUTH_SECRET,
  // STORAGE_UPLOAD_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, R2_SECRET_ACCESS_KEY, CLOUDFLARE_API_TOKEN,
  // CHAMPVAULT_API_KEY, SERVICE_API_KEYS, MAXMIND_LICENSE_KEY, IPINFO_API_TOKEN, COMPANY_INTEL_API_KEY,
  // PROVISIONER_TOKEN) go in `wrangler secret put` or .dev.vars locally. CLERK_* settings are inert since
  // Better Auth and are removed after the rollback window (docs/BETTER-AUTH-PRD.md section 7 step 9).
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG": "false",
    "FRONTEND_URL": "https://champbeam.com",
    "BETTER_AUTH_URL": "https://champbeam.com",
    "REDIRECT_BASE_URL": "https://champbeam.com",
    "PLATFORM_REDIRECT_HOST": "champbeam.com,www.champbeam.com,champbeam.deep-ae0.workers.dev",
    "CLERK_PUBLISHABLE_KEY": "",
    "CORS_ALLOW_ORIGINS": "https://champbeam.com,https://www.champbeam.com,https://champbeam.deep-ae0.workers.dev",
    "CORS_ALLOW_ORIGIN_REGEX": "",
    "STORAGE_PUBLIC_BUCKET_NAME": "champbeam-files"
  },

  // Environment overlays. Bindings and vars are NOT inherited by wrangler environments, so each
  // one is spelled out. Rules (checked by scripts/check-env-overlays.mjs):
  //   * no environment shares a D1 database or R2 bucket with production
  //   * ids marked TODO_ must be filled (by a human, in review) before that env is deployed
  //   * staging/deepify never carry production Clerk keys, sender credentials or customer data
  // Local dev needs no overlay: `wrangler dev` uses the top-level config with local persistence.
  "env": {
    // Runtime rehearsal on Deepify: pinned wrangler/workerd, local-persisted D1/R2, same bundle.
    // Not the Cloudflare control plane (no real hostnames, certificates, Queues, managed latency).
    "deepify": {
      "name": "champbeam-deepify",
      "assets": { "directory": "../frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application",
                  "run_worker_first": ["/*", "!/assets/*"] },
      "d1_databases": [{ "binding": "DB", "database_name": "champbeam-deepify", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "champbeam-files-deepify" }],
      "vars": { "ENVIRONMENT": "deepify", "DEBUG": "false", "FRONTEND_URL": "", "BETTER_AUTH_URL": "TODO_deepify_origin", "REDIRECT_BASE_URL": "", "PLATFORM_REDIRECT_HOST": "",
                "CLERK_PUBLISHABLE_KEY": "", "CORS_ALLOW_ORIGINS": "", "CORS_ALLOW_ORIGIN_REGEX": "", "STORAGE_PUBLIC_BUCKET_NAME": "champbeam-files-deepify" }
    },
    // Real Cloudflare staging: managed D1/R2, real cron, sign-in with NON-production identities.
    "staging": {
      "name": "champbeam-staging",
      // Reset links must carry a champbeam.com host: Microsoft/relay drop mail whose reset link is on workers.dev.
      "routes": [{ "pattern": "staging.champbeam.com", "custom_domain": true }],
      "assets": { "directory": "../frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application",
                  "run_worker_first": ["/*", "!/assets/*"] },
      "d1_databases": [{ "binding": "DB", "database_name": "champbeam-staging", "database_id": "c924f4d4-85ea-4671-8c96-478ae229fe4a", "migrations_dir": "migrations" }],
      "services": [{ "binding": "OPEN_WEBHOOK", "service": "champvoice-edge" }],
      "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "champbeam-files-staging" }],
      "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *"] },
      "vars": { "ENVIRONMENT": "staging", "DEBUG": "false", "FRONTEND_URL": "https://staging.champbeam.com", "BETTER_AUTH_URL": "https://staging.champbeam.com", "REDIRECT_BASE_URL": "https://staging.champbeam.com", "PLATFORM_REDIRECT_HOST": "staging.champbeam.com",
                "CLERK_PUBLISHABLE_KEY": "", "CORS_ALLOW_ORIGINS": "", "CORS_ALLOW_ORIGIN_REGEX": "", "STORAGE_PUBLIC_BUCKET_NAME": "champbeam-files-staging" }
    },
    // ChampBeam Intranet (docs/INTRANET.md, docs/INTRANET-DEPLOY.md): invite-only, review-gated file transfer.
    // Its own Worker, D1 database and R2 bucket; INTRANET_MODE=true serves only the intranet API, Better Auth,
    // health and the intranet SPA (built with VITE_APP_MODE=intranet into ../frontend/dist-intranet).
    // Deployed on Deep's account (deep-ae0) at https://champbeam-intranet.deep-ae0.workers.dev.
    // Secrets (wrangler secret put --env intranet): BETTER_AUTH_SECRET, STORAGE_UPLOAD_SECRET, and optionally
    // R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY (uploads over 100 MB), CLAMD_HOST, CLEF_URL/CLEF_TOKEN, JEV_API_KEY, GLITCHTIP_DSN.
    "intranet": {
      "name": "champbeam-intranet",
      "assets": { "directory": "../frontend/dist-intranet", "binding": "ASSETS", "not_found_handling": "single-page-application",
                  "run_worker_first": ["/*", "!/assets/*"] },
      "d1_databases": [{ "binding": "DB", "database_name": "champbeam-intranet-db", "database_id": "cb5041d5-fe37-40ac-b0de-331ce2f5b02f", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "champbeam-intranet-files" }],
      // One trigger: the intranet sweeper (expiry, invites, reminders, scans, review agent, benchmarks).
      "triggers": { "crons": ["*/5 * * * *"] },
      // NFR-7: Workers Logs (Grafana via an OTLP destination once it exists); GlitchTip via the GLITCHTIP_DSN secret.
      "observability": { "enabled": true },
      "vars": { "ENVIRONMENT": "intranet", "DEBUG": "false", "INTRANET_MODE": "true",
                "FRONTEND_URL": "https://champbeam-intranet.deep-ae0.workers.dev", "BETTER_AUTH_URL": "https://champbeam-intranet.deep-ae0.workers.dev", "REDIRECT_BASE_URL": "https://champbeam-intranet.deep-ae0.workers.dev",
                "PLATFORM_REDIRECT_HOST": "", "CORS_ALLOW_ORIGINS": "", "CORS_ALLOW_ORIGIN_REGEX": "", "CLERK_PUBLISHABLE_KEY": "",
                "STORAGE_PUBLIC_BUCKET_NAME": "champbeam-intranet-files", "INTRANET_ORG_IDS": "6872e11a-c2e3-40b2-a404-c6b0c91fb9f2",
                "INTRANET_MAX_FILE_BYTES": "5368709120", "MAX_BYTES_PER_USER": "5368709120", "INTRANET_INVITE_TTL_DAYS": "7",
                "ASSISTANT_ENABLED": "false", "HTML_SANDBOX": "true" }
    }
  }
}
